# Streamlit Cloud の Secrets 画面でこの内容を貼り付けてください
# 設置場所: https://share.streamlit.io/ → アプリ → Settings → Secrets

LLM_PROVIDER = "gemini"
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL = "gemini-flash-latest"

REINFOLIB_API_KEY = "YOUR_REINFOLIB_API_KEY_HERE"

DEMO_MODE = "false"

# Claude も使う場合（任意）
# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-opus-5"

# ------------------------------------------------------------------
# 分析結果チャット（各タブの「💬 この結果について相談する」）
# ------------------------------------------------------------------
# 上のLLM_PROVIDERとキーをそのまま使います。追加設定は任意。
# GEMINI_CHAT_MODEL = "gemini-flash-latest"   # チャットだけ別モデルにしたい場合
# CLAUDE_CHAT_MODEL = "claude-opus-5"         # LLM_PROVIDER="claude" のとき
# 1セッションあたりの質問数上限（公開URL運用でのコスト暴走防止・既定40）
CHAT_MAX_TURNS_PER_SESSION = "40"
