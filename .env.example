# ============================================================
# これ1本で足りる：Gemini API キー
#   https://aistudio.google.com/apikey で取得（無料枠あり）
#   使うところ：①書類（重説・検査済証PDF）の自動抽出
#               ②自治体条例のweb検索調査
#               ③用途地域の候補調べ（--zoning-lookup）
#               ④結果チャット・追加情報の解釈
# ============================================================
GEMINI_API_KEY=

# --- モデル名（通常は空でよい）---
# 空にしておくと core/gemini_models.py が解決する：候補を試す→廃止なら
# APIが示す後継へ自動切替→それでも駄目なら実在モデルを照会して選ぶ。
# 特定モデルに固定したいときだけ書く（カンマ区切りで優先順）。
# GEMINI_MODEL_CHAIN=gemini-3.6-pro,gemini-3.6-flash
# GEMINI_EXTRACT_MODEL=     # 書類読み取りだけ別モデルにしたいとき
# GEMINI_CHAT_MODEL=        # 結果チャットだけ別モデルにしたいとき

# --- 書類読み取りの精度設定 ---
# スキャンPDFはページ画像に焼き直してから読む（poppler が必要・packages.txt 済み）
EXTRACT_PDF_DPI=300
EXTRACT_MAX_PAGES=12

# 書類解析に使うプロバイダ（gemini / claude / openai）。既定は gemini
LLM_PROVIDER=gemini

# 自治体条例の調査に使うプロバイダ（auto / gemini / claude）。
# auto は Gemini を優先し、無ければ Claude を使う
LEGAL_RESEARCH_PROVIDER=auto

# --- 任意：Claude も併用したいとき ---
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# 国交省 不動産情報ライブラリ API（用途地域・防火地域・学校距離の一次情報）
# https://www.reinfolib.mlit.go.jp/help/apiManual/ で申請（無料・数日）
# ⚠️ ここはLLMで代用しない。用途地域は許可可否の根幹で、誤ると判定が反転するため。
#    キーが無いときは重説・レインズの記載を手入力する（--zoning 商業地域）か、
#    Geminiに候補を出させて人が確認する（--zoning-lookup）。
REINFOLIB_API_KEY=

# デモモード：APIキーがなくてもサンプルデータで動かす
DEMO_MODE=true

# ----------------------------------------------------
# 分析結果チャット（各タブの「この結果について相談する」）
# ----------------------------------------------------
# 使うプロバイダは LLM_PROVIDER（gemini / claude / openai）と共通。
# チャットだけモデルを変えたいとき：
# GEMINI_CHAT_MODEL=gemini-flash-latest
# CLAUDE_CHAT_MODEL=claude-opus-5
# 1セッションあたりの質問数上限（既定40）
CHAT_MAX_TURNS_PER_SESSION=40

# ----------------------------------------------------
# 公開（ngrok）：社内チームに http(s) で共有したいとき
# ----------------------------------------------------
# 1. https://dashboard.ngrok.com/signup で無料アカウント作成（30秒）
# 2. https://dashboard.ngrok.com/get-started/your-authtoken でトークン取得
# 3. 下記にペースト
NGROK_AUTHTOKEN=

# Basic認証（推奨）：URLを知っていてもパスワードを知らないとアクセスできない
# 形式：username:password （例：team:abc123xyz）
NGROK_BASIC_AUTH=

# 固定ドメイン（任意）：ngrokの無料dev domainを使う場合
# 例：snowshoe-trance-badass.ngrok-free.dev
# 指定しなければ毎回ランダムURLになる
NGROK_DOMAIN=



# --- 内部モード（社内利用時のみ true）---
# true にすると「判定ルールブック」のダウンロードが出る（基準YAMLの出典コメント＝
# 人名・実績・案件名をそのまま吐き出すため、公開URLでは出さない）。
# ※「🗣️ 朝会1枚」タブは公開URLでも出る〔社内方針〕
INTERNAL_MODE=false
